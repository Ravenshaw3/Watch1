# Watch1 v3.0.1 - Development Environment Configuration
# This file contains all environment variables for development

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Watch1 Media Server
APP_VERSION=3.0.1
APP_ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Primary database (PostgreSQL for development with Docker)
DATABASE_URL=postgresql://watch1_user:watch1_dev_password@database:5432/watch1_dev
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Fallback database (SQLite for local development)
SQLITE_DATABASE_URL=sqlite:///watch1.db
SQLITE_DATABASE_PATH=./watch1.db

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_CELERY_DB=3

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-2024
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
SECRET_KEY=dev-flask-secret-key-change-in-production-2024

# Password hashing
BCRYPT_LOG_ROUNDS=12

# =============================================================================
# CORS & API CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost
API_V1_STR=/api/v1
API_RATE_LIMIT=100/minute
API_RATE_LIMIT_LOGIN=5/minute

# =============================================================================
# MEDIA CONFIGURATION
# =============================================================================
# Media storage paths
MEDIA_ROOT=/app/media
UPLOAD_FOLDER=/app/uploads
THUMBNAIL_FOLDER=/app/thumbnails
POSTER_FOLDER=/app/posters

# File size limits (in bytes)
MAX_CONTENT_LENGTH=5368709120  # 5GB
MAX_UPLOAD_SIZE=1073741824     # 1GB

# Supported formats
SUPPORTED_VIDEO_FORMATS=mp4,mkv,avi,mov,wmv,flv,webm,m4v
SUPPORTED_AUDIO_FORMATS=mp3,wav,flac,aac,ogg,m4a
SUPPORTED_SUBTITLE_FORMATS=srt,vtt,ass,ssa,sub
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,gif,bmp,webp

# =============================================================================
# STREAMING CONFIGURATION
# =============================================================================
ENABLE_TRANSCODING=false
TRANSCODING_QUALITY=medium
MAX_CONCURRENT_STREAMS=10
STREAM_CHUNK_SIZE=8192
ENABLE_RANGE_REQUESTS=true

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================
CACHE_ENABLED=true
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_THRESHOLD=500

# Media caching
MEDIA_CACHE_ENABLED=true
MEDIA_CACHE_SIZE_GB=10
POSTER_CACHE_ENABLED=true
THUMBNAIL_CACHE_ENABLED=true

# =============================================================================
# SCANNING & INDEXING
# =============================================================================
AUTO_SCAN_ENABLED=false
AUTO_SCAN_INTERVAL_HOURS=24
SCAN_RECURSIVE=true
SCAN_FOLLOW_SYMLINKS=false
BACKUP_BEFORE_SCAN=true

# NFO file processing
PROCESS_NFO_FILES=true
EXTRACT_METADATA=true
GENERATE_THUMBNAILS=true
GENERATE_POSTERS=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_FILE=/app/logs/watch1.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Component logging levels
LOG_LEVEL_SQLALCHEMY=WARNING
LOG_LEVEL_WERKZEUG=INFO
LOG_LEVEL_REDIS=WARNING

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
ENABLE_DEBUG_TOOLBAR=true
ENABLE_PROFILER=true
ENABLE_METRICS=true
ENABLE_API_DOCS=true

# Testing
TESTING=false
TEST_DATABASE_URL=sqlite:///test_watch1.db

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# TMDB API (for metadata enrichment)
TMDB_API_KEY=your-tmdb-api-key-here
TMDB_ENABLED=false

# Email configuration (for notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=noreply@watch1.local

# =============================================================================
# PERFORMANCE & MONITORING
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Worker configuration
WORKER_PROCESSES=2
WORKER_THREADS=4
WORKER_TIMEOUT=30

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_PLAYLISTS=true
FEATURE_ANALYTICS=true
FEATURE_SUBTITLES=true
FEATURE_TRANSCODING=false
FEATURE_SOCIAL=false
FEATURE_RECOMMENDATIONS=false

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# Override any production settings for development
FLASK_ENV=development
FLASK_DEBUG=true
WERKZEUG_DEBUG_PIN=off

# Development database preference
USE_SQLITE_FOR_DEV=true

# Development media paths (Windows)
DEV_MEDIA_PATHS=T:\Movies,T:\TV Shows,T:\Music,T:\Videos,T:\Kids,T:\Music Videos
